NETSURF_FRONTEND := monkey
NETSURF_USE_CURL := YES
NETSURF_USE_OPENSSL := NO
NETSURF_USE_JPEG := NO
NETSURF_USE_JPEGXL := NO
NETSURF_USE_PNG := NO
NETSURF_USE_GIF := YES
NETSURF_USE_BMP := YES
NETSURF_USE_WEBP := NO
NETSURF_USE_VIDEO := NO
NETSURF_USE_NSPSL := NO
NETSURF_USE_NSLOG := NO
NETSURF_USE_UTF8PROC := NO
NETSURF_USE_DUKTAPE := NO
NETSURF_USE_HARU_PDF := NO
NETSURF_USE_LIBICONV_PLUG := YES
NETSURF_STRIP_BINARY := NO
CFLAGS += -I/tmp/ns/libwapcaplet-0.4.3/include -I/tmp/ns/libparserutils-0.2.5/include -I/tmp/ns/libhubbub-0.3.8/include -I/tmp/ns/libcss-0.9.2/include -I/tmp/ns/libdom-0.4.2/include -I/tmp/ns/libnsutils-0.1.1/include -I/tmp/ns/libnsgif-1.0.0/include -I/tmp/ns/libnsbmp-0.1.7/include -I/tmp/ns7/include
LDFLAGS += -L/tmp/nsA
CFLAGS += -Wno-error
LDFLAGS += -L/tmp/nsA -lnsdeps
